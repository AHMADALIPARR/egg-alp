% EGG-001 INVARIANTS: network-Z precondition, entropy preconditions, null definitions H0/H1, test-plan facts.
is_zero(0).

% ---------------------------------------------------------------- C. network Z: Z[t] needs |V_t| >= 1
% Z[t] = sum z / sqrt(|V_t|) is defined only for nonempty V_t; rowvalid(K,S) = number of seconds with K valid devices.
nz_defined_all_t <- rowvalid(0,S), is_zero(S).
% IC inv_nz_empty_valid_set: no second has an empty valid set (else Z[t] would divide by zero)
false <- rowvalid(0,S), not is_zero(S).
% IC inv_nz_precondition_not_established: network-Z consumers need the precondition established from the data
false <- uses_network_z(T), not nz_defined_all_t.
% IC inv_nz_rowvalid_total: seconds-by-valid-device-count histogram sums to the number of seconds
false <- uses_network_z(T), not rowvalid_total_ok.
% IC inv_nz_zero_device_seconds_reported: R network summary agrees: no second with zero devices
false <- network_zero_device_seconds(N), not is_zero(N).
nz_empty_policy(undefined).
allowed_nz_empty_policy(undefined).
% IC inv_nz_empty_policy: empty valid set yields undefined (missing), never 0 and never a division
false <- nz_empty_policy(P), not allowed_nz_empty_policy(P).
uses_network_z(t3). uses_network_z(t4). uses_network_z(t9). uses_network_z(t10).

% ---------------------------------------------------------------- E,F entropy preconditions (per device)
entropy_support_size(201).
entropy_pre(D) <- hist_ok(D), dev_n_positive(D).
% IC inv_entropy_precondition: entropy needs a normalisable histogram (mass = n_valid) and n_valid > 0
false <- device_observed(D), not entropy_pre(D).
% IC inv_entropy_bounds: 0 <= H <= log2(201) for plug-in and Miller-Madow, Hmin >= 0
false <- device_observed(D), not entropy_bounds_ok(D).
% IC inv_hmin_le_h: min-entropy <= Shannon entropy
false <- device_observed(D), not hmin_le_h(D).
% IC inv_pearson_df: Pearson df = pooled bins - 1
false <- device_observed(D), not pearson_df_ok(D).
entropy_estimator(plugin). entropy_estimator(miller_madow). entropy_estimator(theoretical_binomial).
% the three must stay distinct (spec E): the contract names all three
entropy_interpretation(aggregate_count_entropy,not_recoverable_bits).
% IC inv_entropy_as_bits: aggregate-count entropy is never presented as 200 recoverable bits
false <- entropy_interpretation(X,recoverable_bits).

% ---------------------------------------------------------------- A. null model parameters and H0 / H1 definitions
null_param(trials,200). null_param(p_numerator,1). null_param(p_denominator,2). null_param(mean,100). null_param(variance,50).
null_trials_ok <- null_param(trials,N), check_value(meta_trial_size,N).
% IC inv_null_trials_vs_metadata: Binomial n equals the metadata trial size
false <- null_param(trials,N), not null_trials_ok.
h0_component(binomial_200_half). h0_component(independent_cells). h0_component(zero_cross_device_covariance).
h1_requires(null_calibration). h1_requires(missingness_handling). h1_requires(temporal_dependence_control).
h1_requires(multiple_comparison_adjustment). h1_requires(reproducibility_on_independent_data).
% reproducible deviation = candidate deviation that satisfies EVERY h1_requires item
h1_established(X) <- deviation_candidate(X), req_met(X,null_calibration), req_met(X,missingness_handling),
  req_met(X,temporal_dependence_control), req_met(X,multiple_comparison_adjustment), req_met(X,reproducibility_on_independent_data).
% IC inv_h1_requirement_unmet: an h1_established fact needs every h1_requires item met for that candidate
false <- h1_established(X), h1_requires(R), not req_met(X,R).
holdout_absent <- data_csv_count(1).
% IC inv_h1_without_holdout: no H1 establishment while the repo has no independent holdout date
false <- h1_established(X), holdout_absent.
% IC inv_candidate_asserted_h1: raw deviation candidates are exploratory; asserted H1 needs h1_established
false <- asserted_h1(X), not h1_established(X).
% a Holm-adjusted rejection in T1 is only a CANDIDATE (exploratory); it is never h1_established without independent replication
deviation_candidate(Test) <- holm_reject(Test,D).

% ---------------------------------------------------------------- M. test plan facts (docs/EGG-001-ANALYSIS-PLAN.md)
test(t1). test(t2). test(t3). test(t4). test(t5). test(t6). test(t7). test(t8). test(t9). test(t10).
test_null(t1,exact_binomial). test_null(t2,exact_binomial). test_null(t3,binomial_sum_per_second). test_null(t4,circular_shift).
test_null(t5,exact_binomial_simulation). test_null(t6,circular_shift). test_null(t7,exact_tail_and_circular_shift).
test_null(t8,white_noise). test_null(t9,white_noise). test_null(t10,null_simulation_same_missingness_mask).
test_correction(t1,holm_and_bh). test_correction(t2,bh). test_correction(t3,bonferroni_and_bh). test_correction(t4,bh_and_max_t).
test_correction(t5,bh). test_correction(t6,max_t). test_correction(t7,max_t). test_correction(t8,bonferroni_and_bh).
test_correction(t9,bonferroni_and_bh). test_correction(t10,bh).
has_null(T) <- test_null(T,N).
has_correction(T) <- test_correction(T,C).
% IC tp_test_without_null: every planned test names its null
false <- test(T), not has_null(T).
% IC tp_test_without_correction: every planned test names its multiplicity correction
false <- test(T), not has_correction(T).
test_output(t1,r_device_summary). test_output(t2,r_device_quantiles). test_output(t3,r_network_z_summary). test_output(t4,r_crossdev_global).
test_output(t5,r_rolling_global). test_output(t6,r_crossdev_lag_global). test_output(t7,r_crossdev_tail_global). test_output(t8,r_acf_summary).
test_output(t9,r_periodogram_summary). test_output(t10,r_changepoint_candidates).
test_executed(T) <- test_output(T,F), result_file(F).
% NOTE: no rule may negate a DERIVED predicate: the engine's naive fixed point evaluates `not` against the closure of the same pass
% (no stratification), so `test_not_run(T) <- test(T), not test_executed(T)` wrongly fires for every test. Negate derived predicates only inside ICs.
% tests whose results this repo currently REPORTS (static declaration; t10 is only flagged here if declared reported but missing)
test_reported(t1). test_reported(t2). test_reported(t3). test_reported(t4). test_reported(t5). test_reported(t6). test_reported(t7). test_reported(t8). test_reported(t9).
% IC tp_reported_test_has_no_result: a test declared as reported has its result file present with data rows
false <- test_reported(T), not test_executed(T).
% IC tp_preregistration_unbacked: a test labelled preregistered needs a preregistration record (none exists)
false <- preregistered(T), not preregistration_record(T).
% IC tp_fixed_seed_missing: stochastic tests carry a fixed seed
false <- stochastic_test(T), not fixed_seed(T).
stochastic_test(t1). stochastic_test(t4). stochastic_test(t5). stochastic_test(t6). stochastic_test(t7). stochastic_test(t10).
fixed_seed(t1). fixed_seed(t4). fixed_seed(t5). fixed_seed(t6). fixed_seed(t7). fixed_seed(t10).
